---
interface Props { off?: boolean; class?: string }
const { off = false, class: cls = '' } = Astro.props;
---
{off ? (
  <svg class:list={['eye', cls]} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M3 3l14 14M8.2 5.3A8 8 0 0 1 10 5c4.5 0 7.5 5 7.5 5a13 13 0 0 1-2.3 2.8M11.8 14.7A8 8 0 0 1 10 15c-4.5 0-7.5-5-7.5-5a13 13 0 0 1 2.3-2.8" stroke-linecap="round"/>
  </svg>
) : (
  <svg class:list={['eye', cls]} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M2.5 10s3-5 7.5-5 7.5 5 7.5 5-3 5-7.5 5-7.5-5-7.5-5Z"/>
    <circle cx="10" cy="10" r="2.2"/>
  </svg>
)}
