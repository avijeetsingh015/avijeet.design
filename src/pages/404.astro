---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap lost">
    <h1 class="page-title">This layer is empty</h1>
    <p class="page-intro">The page you're looking for doesn't exist or has moved. The work is still here.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a class="btn btn--solid" href="/work/">Go to work</a>
      <a class="btn btn--line" href="/">Go home</a>
    </div>
  </section>
</Base>
